{
  "name": "rayanhost/ai-market-forecast-validator",
  "description": "Auditable AI market forecast validation system",
  "type": "project",
  "require": {
    "php": "^8.4",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": { "psr-4": { "MarketForecast\\": "app/" } },
  "autoload-dev": { "psr-4": { "MarketForecast\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit --colors=always" },
  "config": { "sort-packages": true }
}
